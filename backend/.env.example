# Copy to .env and fill in. .env is git-ignored.

# Alpaca market data (free paper-trading account: https://app.alpaca.markets)
ALPHALAB_ALPACA_API_KEY=
ALPHALAB_ALPACA_SECRET_KEY=
# iex (free, single exchange) or sip (all US exchanges, paid)
ALPHALAB_ALPACA_FEED=iex

# Optional overrides
# ALPHALAB_WATCHLIST=AAPL,MSFT,NVDA,AMZN,GOOGL,META,TSLA,JPM,V,SPY
# ALPHALAB_PRICE_CACHE_TTL_SECONDS=60
# ALPHALAB_DATABASE_URL=postgresql+psycopg://alphalab:alphalab@localhost:5432/alphalab

# Trading engine
# Reject orders while the US market is closed. Set false to test trades after hours.
# ALPHALAB_ENFORCE_MARKET_HOURS=true
# ALPHALAB_SLIPPAGE_BPS=5
# ALPHALAB_COMMISSION_PER_ORDER=0
# ALPHALAB_MAX_PRICE_AGE_SECONDS=300

# AI trading agent (AWS Bedrock)
# Profile must use the restricted AlphaLabBedrock role; the app refuses any other.
# ALPHALAB_AWS_PROFILE=alphalab
# ALPHALAB_AWS_REGION=us-east-1
# Any Bedrock model with tool use via the Converse API.
# ALPHALAB_BEDROCK_MODEL_ID=openai.gpt-oss-120b-1:0
# ALPHALAB_AGENT_MAX_PROPOSALS=5

# Owner key: required for every change (orders, pause/resume, AI runs). Reads are public.
# Generate with: openssl rand -hex 32
ALPHALAB_ADMIN_KEY=
