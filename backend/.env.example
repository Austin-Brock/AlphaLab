# Copy to .env and fill in. .env is git-ignored.

# Alpaca market data (free paper-trading account: https://app.alpaca.markets)
ALPHALAB_ALPACA_API_KEY=
ALPHALAB_ALPACA_SECRET_KEY=
# iex (free, single exchange) or sip (all US exchanges, paid)
ALPHALAB_ALPACA_FEED=iex

# Optional overrides
# ALPHALAB_WATCHLIST=AAPL,MSFT,NVDA,AMZN,GOOGL,META,TSLA,JPM,V,SPY
# ALPHALAB_PRICE_CACHE_TTL_SECONDS=60
# ALPHALAB_DATABASE_URL=postgresql+psycopg://alphalab:alphalab@localhost:5432/alphalab
